{
  "name": "@satoshi/native-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "test": "jest --config jest.config.cjs",
    "test:watch": "jest --config jest.config.cjs --watch",
    "test:coverage": "jest --config jest.config.cjs --coverage",
    "build:lib": "tsc -p tsconfig.build.json",
    "build": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build:lib",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build -o docs/storybook",
    "prepare": "husky"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-native": ">=0.74",
    "react-native-safe-area-context": ">=4.0.0",
    "react-native-svg": ">=15.0.0"
  },
  "dependencies": {
    "react-native-paper": "^5.14.5"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.26.3",
    "@babel/preset-typescript": "^7.26.0",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.39.2",
    "@react-native/babel-preset": "^0.81.5",
    "@react-native/eslint-config": "^0.81.5",
    "@react-native/metro-config": "^0.81.5",
    "@react-native/typescript-config": "^0.81.5",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@storybook/test": "^8.6.19",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.19.3",
    "@types/react": "^19.1.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-jest": "^29.7.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^61.1.12",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^16.2.7",
    "nativewind": "^4.2.1",
    "prettier": "^3.9.10",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "^0.81.5",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-svg": "^15.14.0",
    "react-native-web": "^0.21.0",
    "react-test-renderer": "^19.1.0",
    "storybook": "^8.6.14",
    "tailwindcss": "^3.4.18",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^5.4.20"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20"
  }
}
